# ── AQM Production Environment ──────────────────────────────────────────────
# Copy to .env and fill in real values. NEVER commit .env to git.

# PostgreSQL password
AQM_DB_PASSWORD=change-me-strong-password

# Per-user login passwords
AQM_ALICE_PASSWORD=alice-secret-password
AQM_BOB_PASSWORD=bob-secret-password
AQM_CHARLIE_PASSWORD=charlie-secret-password

# Flask session signing keys (use: python -c "import os; print(os.urandom(24).hex())")
FLASK_SECRET_ALICE=change-me-random-hex
FLASK_SECRET_BOB=change-me-random-hex
FLASK_SECRET_CHARLIE=change-me-random-hex
